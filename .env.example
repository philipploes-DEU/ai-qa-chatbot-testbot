# Umgebungsvariablen fuer AI QA. Diese Datei enthaelt nur leere Platzhalter.
# Kopiere sie zu .env (ist in .gitignore) und trage dort deine Werte ein.
# aiqa.yaml verweist auf diese Variablen mit ${NAME}, nie auf Werte.
# aiqa laedt vor jedem Befehl .env aus dem Arbeitsbereich und danach aus dem Startverzeichnis.
# Variablen aus der Shell haben Vorrang. AIQA_NO_ENV_FILE=1 schaltet das Laden ab.

# Zugang zum Zielsystem (Adapter http, openai-compatible, playwright)
AIQA_TARGET_USER=
AIQA_TARGET_PASSWORD=
AIQA_TARGET_TOKEN=
# auth token mit Login per E-Mail und Passwort, etwa Supabase Auth (README "Auth mit Token")
AIQA_TARGET_EMAIL=
AIQA_SUPABASE_ANON_KEY=

# API-Schluessel fuer das Judge-Modell, referenziert als ${AIQA_JUDGE_API_KEY} im judge-Block
# der aiqa.yaml. Ollama braucht keinen.
AIQA_JUDGE_API_KEY=

# API-Schluessel fuer Planungs- und Analyseagent, referenziert als ${AIQA_AGENTS_API_KEY} im
# agents-Block der aiqa.yaml. Ohne agents-Block nutzen die Agenten das Judge-Modell.
AIQA_AGENTS_API_KEY=

# Beispielziele unter examples/ (pnpm example:mock, pnpm example:bot)
AIQA_EXAMPLE_MOCK_PORT=4010
AIQA_EXAMPLE_BOT_PORT=4020
# Backend des Beispielbots im OpenAI-Format. Standard ist Ollama lokal ohne Schluessel.
# Fuer die Anthropic-Kompatibilitaetsschicht: https://api.anthropic.com/v1 mit Schluessel
# und einem kleinen Modell wie claude-haiku-5-5. Der Judge nutzt ein anderes Modell (Issue #24).
AIQA_EXAMPLE_BOT_BASE_URL=http://localhost:11434/v1
AIQA_EXAMPLE_BOT_API_KEY=
AIQA_EXAMPLE_BOT_MODEL=llama3.2

# advanced-bot "Hilde" (pnpm example:advanced): Claude Haiku über die Anthropic-Kompatibilitaetsschicht.
# Ohne eigenen Schluessel nutzt er AIQA_EXAMPLE_BOT_API_KEY. Jeder Aufruf kostet Geld.
AIQA_ADVANCED_BOT_PORT=4030
AIQA_ADVANCED_BOT_API_KEY=
AIQA_ADVANCED_BOT_MODEL=claude-haiku-5-5
